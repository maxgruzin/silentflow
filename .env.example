# Production: merge these settings into ../docker-config.env on the server.
# Generate a private random secret; never use this placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=0
DJANGO_ALLOWED_HOSTS=silentflow.org www.silentflow.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://silentflow.org https://www.silentflow.org
DJANGO_TRUST_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=3600
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
